import pandas as pd

# SQL query to compute total sales per country, sorted descending, and return the top 2
sql = """
SELECT Country, SUM(Sales) AS TotalSales
FROM table_fdb2aab9d816c2708aeac8df521b1e2c
GROUP BY Country
ORDER BY TotalSales DESC
LIMIT 2
"""

df = execute_sql_query(sql)

# Determine the second highest total sales
if not df.empty and len(df) >= 2:
    second_country = df.iloc[1]['Country']
    second_sales = df.iloc[1]['TotalSales']
    message = (
        f"The country with the second highest total sales is "
        f"{second_country} with a total of {second_sales}."
    )
else:
    message = "No second highest sales data available."

result = {'type': 'string', 'value': message}
