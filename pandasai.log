# TODO: import the required dependencies
import pandas as pd
import json

# Table name
TABLE_NAME = "table_7dd83f60783fad77ab73ac8622c21f14"

# ---- Gather basic metadata ----
# Number of rows
rows_df = execute_sql_query(f"SELECT COUNT(*) AS rows FROM {TABLE_NAME};")
rows_count = rows_df["rows"][0]

# Column names and data types
info_df = execute_sql_query(f"SELECT name, type FROM pragma_table_info('{TABLE_NAME}') ORDER BY cid;")
column_names = info_df["name"].tolist()
column_types = dict(zip(info_df["name"], info_df["type"]))
cols_count = len(column_names)

# Key fields (simple heuristic: 'id' is a unique key if its distinct count equals total rows)
key_fields = []
id_distinct_df = execute_sql_query(f"SELECT COUNT(DISTINCT id) AS distinct_id FROM {TABLE_NAME};")
if id_distinct_df["distinct_id"][0] == rows_count:
    key_fields.append("id")

# ---- Check for missing values ----
missing_counts = {}
for col in column_names:
    miss_df = execute_sql_query(f"SELECT COUNT(*) AS miss FROM {TABLE_NAME} WHERE {col} IS NULL;")
    miss_count = miss_df["miss"][0]
    if miss_count > 0:
        missing_counts[col] = miss_count

# ---- Detect simple anomalies ----
# Example anomalies: age out of realistic bounds or negative score
anomaly_df = execute_sql_query(f"""
    SELECT COUNT(*) AS anomalies
    FROM {TABLE_NAME}
    WHERE (age < 0 OR age > 120) OR (score < 0);
""")
anomaly_count = anomaly_df["anomalies"][0]

# ---- Build summary string ----
summary_parts = [
    f"Number of rows: {rows_count}",
    f"Number of columns: {cols_count}",
    f"Columns (name : type): {', '.join([f'{name} : {column_types[name]}' for name in column_names])}",
]
if key_fields:
    summary_parts.append(f"Potential key field(s): {', '.join(key_fields)}")
else:
    summary_parts.append("No unique key field detected.")

if missing_counts:
    summary_parts.append(
        f"Missing values per column: {', '.join([f'{col} ({cnt})' for col, cnt in missing_counts.items()])}"
    )
else:
    summary_parts.append("No missing values detected.")

if anomaly_count:
    summary_parts.append(f"Anomalies detected: {anomaly_count} row(s)")
else:
    summary_parts.append("No anomalies detected.")

summary = "\n".join(summary_parts)

# Declare result variable
result = {
    "type": "string",
    "value": summary
}
