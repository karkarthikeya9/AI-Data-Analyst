import pandas as pd

# SQL query to find the country that ranks 4th by Sales (descending order)
sql_query = """
    SELECT Country
    FROM (
        SELECT Country,
               Sales,
               ROW_NUMBER() OVER (ORDER BY Sales DESC) AS rn
        FROM table_fdb2aab9d816c2708aeac8df521b1e2c
    )
    WHERE rn = 4
"""

# Execute the query
df = execute_sql_query(sql_query)

# Safely extract the country (handle case where rank 4 does not exist)
country_rank4 = df.iloc[0]['Country'] if not df.empty else "N/A"

# Return result in the required format
result = {'type': 'string', 'value': country_rank4}
result
