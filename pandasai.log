# Execute an SQL query that aggregates sales per country and selects the country with the highest total sales
query = """
SELECT Country, SUM(Sales) AS total_sales
FROM table_fdb2aab9d816c2708aeac8df521b1e2c
GROUP BY Country
ORDER BY total_sales DESC
LIMIT 1
"""

